rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(data) {
      return request.auth != null && data.uid == request.auth.uid;
    }

    // Public profiles are readable by everyone, but only the signed-in owner
    // can create, update or delete their own handle document.
    match /profiles/{handle} {
      allow read: if true;
      allow create: if isOwner(request.resource.data);
      allow update: if isOwner(resource.data) && isOwner(request.resource.data);
      allow delete: if isOwner(resource.data);
    }

    // Private pointer from a user uid to their current handle.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
